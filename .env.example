# Amazon Tariff Calculator - Environment Variables
# Copy this file to .env and fill in your values before building

# OpenRouter API key
VITE_OPENROUTER_API_KEY=your-openrouter-api-key

# Upstash Redis connection details
VITE_UPSTASH_REDIS_URL=your-upstash-redis-url
VITE_UPSTASH_REDIS_TOKEN=your-upstash-redis-token